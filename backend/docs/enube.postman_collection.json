			"item": [
				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extrair o token da resposta JSON",
									"const responseJson = pm.response.json();",
									"const token = responseJson.token; // Pega o valor do campo \"token\"",
									"",
									"// Salva o token em uma variável de ambiente chamada \"JWT\"",
									"pm.collectionVariables.set(\"JWT\", token);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
